   "source": [
    "##  Predicting Delivery Delays\n",
    "\n",
    "We build a classification model to predict whether an order will be delayed."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "fe11acfa",
   "metadata": {},
   "outputs": [],
   "source": [
    "ml_data = df[df[\"order_status\"] == \"delivered\"].copy()\n",
    "\n",
    "ml_data = ml_data.dropna(subset=[\"delay\", \"processing_time\", \"shipping_time\"])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "41dcf1de",
   "metadata": {},
   "outputs": [],
   "source": [
    "features = ml_data[[\n",
    "    \"processing_time\",\n",
    "    \"shipping_time\",\n",
    "    \"customer_state\"\n",
    "]]\n",
    "\n",
    "target = ml_data[\"is_late\"]\n",
    "\n",
    "features_encoded = pd.get_dummies(features, drop_first=True)"
   ]
  },
