    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1d93f993",
   "metadata": {},
   "source": [
    "## Delivery Days\n",
    "Understanding how many it takes for order to get delivered"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "5625c529",
   "metadata": {},
   "outputs": [],
   "source": [
    "df['delivery_days'] = ( df['order_delivered_customer_date'] - df['order_purchase_timestamp']).dt.days"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6551ab91",
   "metadata": {},
   "source": [
    "## Delay Days\n",
    "Helps in understanding how many days delay occur"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "f491b43b",
   "metadata": {},
   "outputs": [],
   "source": [
    "df['delay_days'] = (df['order_delivered_customer_date']  - df['order_estimated_delivery_date']).dt.days"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "da39d69e",
   "metadata": {},
   "source": [
    "## Processing Time\n",
    "Time taken to actually approve the order after purchasing it"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "1222c252",
   "metadata": {},
   "outputs": [],
   "source": [
    "df['processing_time'] = (df['order_approved_at'] - df['order_purchase_timestamp']).dt.days"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "dc155ba8",
   "metadata": {},
   "source": [
    "## Shipping Time\n",
    "Time taken to deliver the order after it being approved"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 36,
   "id": "50868133",
   "metadata": {},
   "outputs": [],
   "source": [
    "df['order_delivered_carrier_date'] = pd.to_datetime(\n",
    "    df['order_delivered_carrier_date']\n",
    ")\n",
    "df['order_approved_at'] = pd.to_datetime(\n",
    "    df['order_approved_at']\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 37,
   "id": "4f417f9d",
   "metadata": {},
   "outputs": [],
   "source": [
    "df['shipping_time'] = (df['order_delivered_carrier_date'] - df['order_approved_at']).dt.days"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7bea4a17",
   "metadata": {},
   "source": [
    "## Delivery Status Label"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 30,
   "id": "8cbe633c",
   "metadata": {},
   "outputs": [],
   "source": [
    "df['delivery_status']=df['is_late'].map({\n",
    "    False: 'On Time',\n",
    "    True: 'Late'\n",
    "})"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "54014dfa",
   "metadata": {},
   "source": [
    "## Delay Severity"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 45,
   "id": "f490b3a3",
   "metadata": {},
   "outputs": [],
   "source": [
    "def delay_category(x):\n",
    "\n",
    "    if x <= 0:\n",
    "        return 'On Time'\n",
    "\n",
    "    elif x <= 3:\n",
    "        return 'Slight Delay'\n",
    "\n",
    "    elif x <= 7:\n",
    "        return 'Moderate Delay'\n",
    "\n",
    "    else:\n",
    "        return 'Severe Delay'\n",
    "\n",
    "\n",
    "df['delay_severity'] = df['delay_days'].apply(delay_category)"
   ]
  },
